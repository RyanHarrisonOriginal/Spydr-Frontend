# Copy to .env.local and fill in values (see README).

# Backend API (default used if unset: http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api

# Clerk (required for sign-in)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Active Note
# true  = full in-memory mock workflow (no backend)
# false = analyze uses POST /api/active-notes/analyze; save is a local draft;
#         apply is not available until a later backend increment
# VITE_USE_ACTIVE_NOTE_MOCKS=false
