# Copy to .env.local and fill in values (see README).

# Backend API (default used if unset: http://localhost:3001/api)
# VITE_API_URL=http://localhost:3001/api

# Public Spydr MCP HTTP endpoint (default: https://api.spydr-app.cloud/mcp)
# VITE_MCP_SERVER_URL=https://api.spydr-app.cloud/mcp

# Clerk (required for sign-in)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
